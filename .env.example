# Пример настроек KingPromotion. Скопируйте в backend/.env и заполните.
# НИКОГДА не помещайте настоящие ключи в этот файл.

# --- База данных и секреты ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/kingpromotion
SECRET_KEY=замените-на-случайный-секрет
DATABASE_ECHO=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend ---
FRONTEND_URL=https://your-frontend.example.com

# --- Внешний сервис KingPromotion ---
KINGPROMOTION_API_URL=https://kingpromotion.space/api/v2/
KINGPROMOTION_API_KEY=
KINGPROMOTION_MARKUP_PERCENT=50
REFERRAL_REWARD_PERCENT=12
ADMIN_USER_IDS=1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ADMIN_CHAT_ID=
TELEGRAM_BOT_USERNAME=KingPromotion_Support_bot
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
TELEGRAM_SUPPORT_ADMIN_IDS=

# --- VK ID ---
VK_APP_ID=54737931
VK_REDIRECT_URL=https://your-frontend.example.com/auth/vk/callback
VK_AUTH_SESSION_EXPIRE_MINUTES=10

# --- ЮKassa (СБП) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://your-frontend.example.com/payment/success
YOOKASSA_WEBHOOK_URL=https://your-backend.example.com/api/payments/yookassa/webhook
YOOKASSA_CONNECT_TIMEOUT_SECONDS=3
YOOKASSA_READ_TIMEOUT_SECONDS=12

# --- CrystalPAY ---
CRYSTALPAY_AUTH_LOGIN=
CRYSTALPAY_AUTH_SECRET=
CRYSTALPAY_SALT=
CRYSTALPAY_CALLBACK_URL=https://your-backend.example.com/api/payments/crystalpay/callback
CRYSTALPAY_REDIRECT_URL=https://your-frontend.example.com/main?section=balance&topup=return
CRYSTALPAY_ORDER_REDIRECT_URL=https://your-frontend.example.com/payment/success
CRYSTALPAY_API_URL=https://api.crystalpay.io/v3/
CRYSTALPAY_INVOICE_LIFETIME_MINUTES=15
CRYSTALPAY_TIMEOUT_SECONDS=12

# --- Heleket (криптовалютные платежи) ---
# Используется PAYMENT API KEY (приём платежей), а НЕ Payout API Key.
HELEKET_MERCHANT_ID=
HELEKET_PAYMENT_API_KEY=
# Публичный HTTPS-адрес backend:
HELEKET_CALLBACK_URL=https://your-backend.example.com/api/payments/heleket/webhook
HELEKET_SUCCESS_URL=https://your-frontend.example.com/main?section=balance&topup=return&heleket=success
HELEKET_RETURN_URL=https://your-frontend.example.com/main?section=balance&topup=return&heleket=success
# Валюта инвойса у провайдера. На баланс зачисляется зафиксированная
# локальная сумма в рублях независимо от валюты платежа.
HELEKET_CURRENCY=RUB
HELEKET_API_URL=https://api.heleket.com
HELEKET_INVOICE_LIFETIME_MINUTES=15
HELEKET_TIMEOUT_SECONDS=30

# --- Прочие платежи ---
PAYMENT_TIMEOUT_MINUTES=15
PAYMENT_EXPIRY_SWEEP_SECONDS=60
